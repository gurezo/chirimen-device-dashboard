{
  "name": "libs-device-detail",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/devices/device-detail/src",
  "prefix": "chirimen",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/devices/device-detail",
        "main": "libs/devices/device-detail/src/index.ts",
        "tsConfig": "libs/devices/device-detail/tsconfig.lib.json",
        "assets": [],
        "generatePackageJson": false,
        "rootDir": "."
      },
      "configurations": {
        "production": {},
        "development": {}
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/libs/devices/device-detail"
      ],
      "options": {
        "coverage.reportsDirectory": "../../../../../coverage/libs/devices/device-detail"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
